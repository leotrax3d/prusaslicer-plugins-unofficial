{
  "openapi": "3.1.0",
  "info": {
    "title": "print-guard",
    "version": "0.1.0",
    "description": "The routes Print Guard serves. Every path is relative to the mount the host assigns."
  },
  "paths": {
    "/status": {
      "get": {
        "operationId": "read-status",
        "summary": "Every camera Print Guard follows",
        "description": "The detector and action in use, and for every camera that sent a snapshot: its printer, whether it prints, the latest score and the verdict. The host takes view_resource on the module's instance before this is called.",
        "responses": {
          "200": {
            "description": "The cameras followed.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}
          }
        }
      }
    },
    "/incidents": {
      "get": {
        "operationId": "list-incidents",
        "summary": "The prints judged failed, newest first",
        "description": "Every incident Print Guard stored, at most 50 per printer, newest first. The host takes view_resource on the module's instance before this is called.",
        "parameters": [
          {"name": "printer", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Only this printer's incidents."}
        ],
        "responses": {
          "200": {
            "description": "The incidents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"incidents": {"type": "array", "items": {"$ref": "#/components/schemas/Incident"}}},
                  "required": ["incidents"]
                }
              }
            }
          },
          "503": {"description": "The record store did not answer.", "content": {"application/problem+json": {"schema": {"type": "object"}}}}
        }
      }
    },
    "/printers/{printer}/reset": {
      "post": {
        "operationId": "reset-printer",
        "summary": "Mark the current picture as normal",
        "description": "For a false alarm: every camera of the printer starts a new baseline, and Print Guard may act again on this print. The host takes operate_resource on the module's instance before this is called.",
        "parameters": [
          {"name": "printer", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "204": {"description": "The baseline starts over."},
          "404": {"description": "No camera of this printer has sent a snapshot.", "content": {"application/problem+json": {"schema": {"type": "object"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Box": {
        "type": "object",
        "properties": {
          "label": {"type": "string"},
          "confidence": {"type": "number"},
          "x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number"}, "h": {"type": "number"}
        },
        "required": ["label", "confidence", "x", "y", "w", "h"]
      },
      "Watch": {
        "type": "object",
        "properties": {
          "camera": {"type": "string"},
          "printer": {"type": "string"},
          "printing": {"type": "boolean"},
          "verdict": {"type": "string", "enum": ["warming_up", "ok", "warning", "failing"]},
          "score": {"type": "number", "description": "The latest frame's score."},
          "excess": {"type": "number", "description": "The smoothed score above the print's baseline, which the thresholds judge."},
          "frames": {"type": "integer"},
          "last": {"type": "string", "format": "date-time"},
          "error": {"type": "string"},
          "acted": {"type": "boolean", "description": "Print Guard already acted on this print."}
        },
        "required": ["camera", "printer", "printing", "verdict", "score", "excess", "frames", "last", "acted"]
      },
      "Status": {
        "type": "object",
        "properties": {
          "detector": {"type": "string", "enum": ["heuristic", "obico"]},
          "action": {"type": "string", "enum": ["pause", "notify"]},
          "cameras": {"type": "array", "items": {"$ref": "#/components/schemas/Watch"}}
        },
        "required": ["detector", "action", "cameras"]
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "printer": {"type": "string"},
          "camera": {"type": "string"},
          "time": {"type": "string", "format": "date-time"},
          "score": {"type": "number"},
          "excess": {"type": "number"},
          "detector": {"type": "string"},
          "action": {"type": "string"},
          "outcome": {"type": "string"},
          "storage": {"type": "string"},
          "path": {"type": "string"},
          "boxes": {"type": "array", "items": {"$ref": "#/components/schemas/Box"}}
        },
        "required": ["id", "printer", "camera", "time", "score", "excess", "detector", "action", "outcome", "storage", "path"]
      }
    }
  }
}
